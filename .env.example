# Variáveis públicas — inlined no bundle pelo Metro (prefixo EXPO_PUBLIC_).
# A anon key do Supabase é pública por design. Segredos de verdade NÃO vão aqui.
# Copie para .env e preencha. O .env real NÃO é commitado (ver .gitignore).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=development

# Observabilidade (opcional). Sem DSN, o Sentry fica desativado (no-op).
EXPO_PUBLIC_SENTRY_DSN=

# IAP / RevenueCat (opcional). Sem chaves, o billing fica em modo stub
# (paywall mostra "em breve"). Preencher quando a conta Apple estiver ativa.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
